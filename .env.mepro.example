# Tambahkan/ubah baris berikut di file .env proyek Laravel Anda

APP_TIMEZONE=UTC          # JANGAN ubah. Zona waktu tampilan diatur MEPRO_TIMEZONE
MEPRO_TIMEZONE=Asia/Jakarta

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mepro
DB_USERNAME=mepro
DB_PASSWORD=secret

BROADCAST_CONNECTION=reverb
# (REVERB_* dan VITE_REVERB_* dibuat otomatis oleh `php artisan install:broadcasting`)

MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=mepro-listener

MEPRO_IDLE_THRESHOLD=120
MEPRO_OFFLINE_AFTER=90
MEPRO_RAW_RETENTION_DAYS=30
MEPRO_INTEGRATION_KEY=ganti-dengan-kunci-acak-panjang
